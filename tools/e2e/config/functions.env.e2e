# Emulator-safe Functions env for NexRide E2E (Phase 0+).
# Installed to nexride_driver/functions/.env by tools/e2e/run-phase0.sh.
# Do not commit nexride_driver/functions/.env — use this template instead.

# --- Firebase defineString params (required for non-interactive emulator startup) ---
NEXRIDE_PLATFORM_FEE_NGN=30
NEXRIDE_SMALL_ORDER_FEE_NGN=15
NEXRIDE_SMALL_ORDER_THRESHOLD_NGN=3000
FLUTTERWAVE_PUBLIC_KEY=e2e-flw-public-key

# --- Env overrides read by params.js / payment paths (no real provider calls in Phase 0) ---
FLUTTERWAVE_SECRET_KEY=e2e-local-dummy-secret
FLUTTERWAVE_WEBHOOK_SECRET=e2e-local-dummy-webhook

# --- Phase 1+: local Flutterwave verify stub (tools/e2e/mocks/flutterwave-stub.mjs) ---
E2E_FLUTTERWAVE_API_BASE=http://127.0.0.1:9199

# --- Optional runtime env (safe to leave empty for Phase 0) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
WORKER_IDENTITY_CLAIM_PEPPER=e2e-local-identity-pepper
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXRIDE_RBAC_LEGACY_SUPER_EMAILS=admin@nexride.local
